<Window x:Class="PhoenixWPF.Dialogs.KampfauswertungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kampfauswertung" Height="700" Width="1020"
        WindowStartupLocation="CenterOwner"
        Background="#202020" Foreground="LightGray">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kopfzeile: laden -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Name="LadenButton" Content="Zugdaten der Reiche laden…" Width="200" Height="28"
                    Margin="0,0,10,0" Click="LadenButton_Click" />
            <TextBlock Name="StandLabel" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="#FFB0B0B0" />
        </StackPanel>

        <!-- Links: die gefundenen Konflikte -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Konflikte" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox Name="KonfliktListe" Background="#303030" Foreground="LightGray"
                     SelectionChanged="KonfliktListe_SelectionChanged" />
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

        <!-- Rechts: die Schlacht -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Angreifer:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Name="AngreiferAuswahl" Width="180" Height="24"
                          SelectionChanged="AngreiferAuswahl_SelectionChanged" />
                <TextBlock Text="Trefferpunkte gegen den Verteidiger:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Name="TrefferGegenVerteidiger" Width="70" Height="24" Text="0"
                         Background="#303030" Foreground="LightGray" />
                <TextBlock Text="gegen den Angreifer:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Name="TrefferGegenAngreifer" Width="70" Height="24" Text="0"
                         Background="#303030" Foreground="LightGray" />
            </StackPanel>

            <DataGrid Grid.Row="1" Name="HeereGrid" AutoGenerateColumns="False"
                      Background="#303030" Foreground="LightGray" RowBackground="#303030"
                      AlternatingRowBackground="#383838" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Angreifer" Binding="{Binding IstAngreifer, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    <DataGridTextColumn Header="Reich" Binding="{Binding Reich}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Heer" Binding="{Binding Bezeichnung}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Stärke" Binding="{Binding Stärke}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="HF" Binding="{Binding Heerführer}" Width="50" IsReadOnly="True" />
                    <DataGridTextColumn Header="Kat." Binding="{Binding Katapulte}" Width="50" IsReadOnly="True" />
                    <DataGridTextColumn Header="GP" Binding="{Binding Gutpunkte, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    <DataGridTextColumn Header="Herkunft der GP" Binding="{Binding Herkunft}" Width="200" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,6">
                <Button Name="BerechnenButton" Content="Berechnen" Width="110" Height="28"
                        Margin="0,0,8,0" Click="BerechnenButton_Click" />
                <Button Name="ÜbernehmenButton" Content="Übernehmen" Width="110" Height="28"
                        Margin="0,0,8,0" IsEnabled="False" Click="ÜbernehmenButton_Click" />
                <Button Name="KopierenButton" Content="In die Zwischenablage" Width="160" Height="28"
                        IsEnabled="False" Click="KopierenButton_Click" />
            </StackPanel>

            <TextBox Grid.Row="3" Name="BerichtText" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                     Background="#303030" Foreground="LightGray" />
        </Grid>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Name="HinweisLabel" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="#FFB0B0B0" TextWrapping="Wrap" />
            <Button Content="Schließen" Width="100" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
