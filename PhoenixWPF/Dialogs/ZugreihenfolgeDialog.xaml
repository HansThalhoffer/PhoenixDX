<Window x:Class="PhoenixWPF.Dialogs.ZugreihenfolgeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zugreihenfolge" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#202020" Foreground="LightGray">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="MonatLabel" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Name="AuftauchpunktLabel" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#FFB0B0B0" />

        <DataGrid Grid.Row="2" Name="ReihenfolgeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#303030" Foreground="LightGray" RowBackground="#303030"
                  AlternatingRowBackground="#383838" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reihenfolge" Binding="{Binding Reihenfolge}" Width="90" />
                <DataGridTextColumn Header="Reich" Binding="{Binding Reich}" Width="*" />
                <DataGridTextColumn Header="Auftauchpunkt" Binding="{Binding Auftauchpunkt_A}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="VorherButton" Content="&lt; Vorheriger Zug" Width="120" Height="28" Margin="0,0,8,0" Click="VorherButton_Click" />
            <Button Name="NachherButton" Content="Nächster Zug &gt;" Width="120" Height="28" Margin="0,0,8,0" Click="NachherButton_Click" />
            <Button Content="Schließen" Width="100" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
