<Window x:Class="PhoenixWPF.Dialogs.GemarkInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemark" Height="600" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#202020" Foreground="LightGray">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="KopfLabel" FontWeight="Bold" FontSize="15" Margin="0,0,0,2" />
        <TextBlock Grid.Row="1" Name="UnterLabel" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#FFB0B0B0" />

        <DataGrid Grid.Row="2" Name="EigenschaftenGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#303030" Foreground="LightGray" RowBackground="#303030"
                  AlternatingRowBackground="#383838" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Eigenschaft" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="Wert" Binding="{Binding Wert}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Name="FigurenLabel" FontWeight="Bold" Margin="0,12,0,4" />

        <DataGrid Grid.Row="4" Name="FigurenGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#303030" Foreground="LightGray" RowBackground="#303030"
                  AlternatingRowBackground="#383838" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reich" Binding="{Binding Reich}" Width="110" />
                <DataGridTextColumn Header="Nummer" Binding="{Binding Nummer}" Width="70" />
                <DataGridTextColumn Header="Art" Binding="{Binding Art}" Width="110" />
                <DataGridTextColumn Header="Stärke" Binding="{Binding Stärke}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="SchliessenButton" Content="Schließen" Width="100" Height="28" Click="SchliessenButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
